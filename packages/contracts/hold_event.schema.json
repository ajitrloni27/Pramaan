{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HoldEvent",
  "type": "object",
  "required": ["hold_id", "invoice_id", "amount", "status", "reversible", "expires_at", "placed_by", "confidence_floor"],
  "properties": {
    "hold_id":          { "type": "string" },
    "invoice_id":       { "type": "string" },
    "amount":           { "type": "number" },
    "status":           { "enum": ["staged", "placed", "released"] },
    "reversible":       { "type": "boolean" },
    "expires_at":       { "type": ["string", "null"] },
    "placed_by":        { "enum": ["auto", "user"] },
    "confidence_floor": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
