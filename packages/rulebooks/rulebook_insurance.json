        }
      },
      {
        "id": "MCHEALTH2024",
        "ref": "IRDAI/HLT/CIR/PRO/84/5/2024",
        "title": "Health Insurance Business, 2024",
        "effective_date": "2024-05-29",
        "product_guidelines": {
          "coverage_mandates": [
            "All ages and medical conditions",
            "Pre-existing diseases and chronic conditions",
            "All systems of medicine (Allopathy, AYUSH, etc.)",
            "Domiciliary, OPD, Day Care, Homecare",
            "Technological advancements (Robotic surgery, Stem cell, etc.)"
          ],
          "legal_compliance": [
            "Mental Healthcare Act, 2017",
            "Rights of Persons with Disabilities Act, 2016",
            "Surrogacy (Regulation) Act, 2021",
            "Transgender Persons (Protection of Rights) Act, 2019",
            "HIV and AIDS (Prevention and Control) Act, 2017"
          ],
          "policyholder_rights": {
            "freelookperiod": "30 days from receipt of policy",
            "cancellation": "7 days notice; refund proportionate premium if no claim",
            "grace_period": "15 days (monthly), 30 days (quarterly/half-yearly/annual)",
            "portability": "Allowed between insurers; credits (waiting periods, NCB) must transfer",
            "moratorium_period": "60 months continuous coverage; policy cannot be contested except for fraud",
            "cashless_settlement": "Target 100%; decision within 1 hour; final discharge auth within 3 hours"
          },
          "claims_process": {
            "repudiation_approval": "Must be approved by Product Management Committee (PMC) or Claims Review Committee (CRC)",
            "document_collection": "Insurer/TPA to collect from hospital; policyholder not required to submit",
            "multiple_policies": "Indemnity: Claim from any one (primary); Benefit: Claim from all"
          }
        }
      }
    ]
  },
  "complianceenginerules": {
    "rule_categories": [
      {
        "category": "Rural_Obligation",
        "rules": [
          {
            "ruleid": "RURALLIFE_FY26",
            "applicable_to": "Life Insurers",
            "condition": "Financial Year == 2025-26",
            "requirement": "Cover >= 15% lives in allocated Gram Panchayats",
            "verification": "Gram Sachiv Certificate / Self-certification (max 25%)"
          },
          {
            "ruleid": "RURALGENERAL_FY26",
            "applicable_to": "General Insurers (Type 1)",
            "condition": "Financial Year == 2025-26",
            "requirement": "Cover >= 15% dwellings/shops AND >= 15% motor vehicles in allocated Gram Panchayats",
            "verification": "Gram Sachiv Certificate / IIB Data Cross-check"
          }
        ]
      },
      {
        "category": "SocialSectorObligation",
        "rules": [
          {
            "ruleid": "SOCIALALL_FY26",
            "applicable_to": "All Insurers (excl AIC, ECGC)",
            "condition": "Financial Year == 2025-26",
            "requirement": "Cover >= 10% of total lives covered under social sector definition",
            "verification": "Govt scheme beneficiary list / Self-certification (max 20%)"
          }
        ]
      },
      {
        "category": "MotorTPObligation",
        "rules": [
          {
            "ruleid": "MOTORTPGROWTHFY26",
            "applicable_to": "General Insurers (Type 1)",
            "condition": "Financial Year == 2025-26 AND Market Share = 12.50%",
            "verification": "IIB Database cross-verification"
          }
        ]
      },
      {
        "category": "HealthProductCompliance",
        "rules": [
          {
            "ruleid": "HEALTHCASHLESS_TAT",
            "applicable_to": "Health Insurers",
            "condition": "Cashless Authorization Request",
            "requirement": "Decision within 1 hour",
            "penalty": "Shareholder fund bears cost if delay > 3 hours for discharge"
          },
          {
            "ruleid": "HEALTHMORATORIUM",
            "applicable_to": "Health Insurers",
            "condition": "Continuous Coverage >= 60 months",
            "requirement": "Cannot contest policy/claim except for proven fraud",
            "action": "Auto-approve claim validation logic"
          }
        ]
      },
      {
        "category": "Grievance_Redressal",
        "rules": [
          {
            "ruleid": "GRVTAT",
            "applicable_to": "All Insurers",
            "condition": "Complaint Received",
            "requirement": "Resolve within 14 days",
            "escalation": "Inform policyholder of Ombudsman option if unresolved > 30 days"
          },
          {
            "ruleid": "OMBUDSMANAWARD_COMPLIANCE",
            "applicable_to": "All Insurers",
            "condition": "Ombudsman Award Received",
            "requirement": "Comply within 30 days",
            "penalty": "5000 INR/day to complainant if delayed"
          }
        ]
      }
    ]
