            }
          },
          "social_sector": {
            "all_insurers": {
              "fy202526": { "minlivescoveragepctof_total": 10 },
              "fy202627": { "minlivescoveragepctof_total": 12 }
            }
          },
          "motorthirdparty": {
            "generalinsurers1": {
              "growthtargetsfy202526": {
                "marketshareupto_2pct": 12.50,
                "marketshare2to5pct": 10.00,
                "marketshare5to10pct": 7.50,
                "marketshareabove_10pct": 5.00
              },
              "growthtargetsfy202627": {
                "marketshareupto_2pct": 13.75,
                "marketshare2to5pct": 11.00,
                "marketshare5to10pct": 8.25,
                "marketshareabove_10pct": 5.50
              }
