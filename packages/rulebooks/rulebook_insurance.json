    "actsandrules": [
      {
        "id": "INSACT1938",
        "title": "The Insurance Act, 1938",
        "type": "Primary Legislation",
        "key_provisions": {
          "registration": "Mandatory for all insurers (Sec 3)",
          "capital_requirements": {
            "lifegeneralhealth": "100 Crore INR",
            "reinsurance": "200 Crore INR"
          },
          "investments": "Assets must be invested in approved securities (Govt bonds, etc.) (Sec 27)",
          "solvency": "Must maintain solvency margin (Sec 64VA)",
          "rural_obligations": "Mandatory insurance business in rural/social sectors (Sec 32B, 32C)",
          "motortpobligations": "Mandatory underwriting of motor third party risks (Sec 32D)"
        }
      },
      {
        "id": "OMBUDSMANRULES2017",
        "title": "Insurance Ombudsman Rules, 2017",
        "type": "Rules",
        "jurisdiction_limit": "50 Lakh INR",
        "complaint_grounds": [
          "Delay in settlement of claims",
          "Repudiation of claims",
          "Disputes over premium",
          "Misrepresentation of policy terms",
          "Policy servicing grievances",
          "Non-issuance of policy after premium receipt"
        ],
        "process": {
          "prerequisite": "Written representation to insurer must be made first; rejected or no reply within 1 month",
          "time_limit": "Within 1 year from rejection/dissatisfaction",
          "award_binding": "Binding on insurer; must be complied with within 30 days",
          "penaltyfordelay": "5000 INR per day payable to complainant if award not honoured"
        }
      }
    ],
